# ─── Friendnix Frontend Environment ───────────────────────────────────────────
#
# Leave VITE_BACKEND_URL empty when the frontend is served from the SAME server
# as the backend (Railway / Render self-hosted). The app will use relative /api paths.
#
# Set it to your deployed backend URL for split deployments (e.g. Vercel frontend
# + Railway backend):
#   VITE_BACKEND_URL=https://your-app.up.railway.app
#
# For LOCAL development on multiple devices (e.g. phone + PC on same WiFi):
#   1. Find your PC's local IP:  ipconfig  →  IPv4 Address (e.g. 192.168.1.10)
#   2. Set:  VITE_BACKEND_URL=http://192.168.1.10:3001
#   3. Make sure the backend is running on your PC
#   4. Open http://192.168.1.10:5173 on the other device
#
VITE_BACKEND_URL=
